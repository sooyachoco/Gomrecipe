{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gomjiyeon-recipe-note",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gomjiyeon-recipe-db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "gomjiyeon-recipe-images"
    }
  ]
}
